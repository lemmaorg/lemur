{
  "name": "lemur",
  "productName": "Lemur",
  "version": "0.5.0",
  "description": "Lemur — a modular study platform for speed reading, annotation and knowledge mapping. Made by Lemma.",
  "author": "Lemma",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/lemmaorg/lemur",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemmaorg/lemur.git"
  },
  "bugs": {
    "url": "https://github.com/lemmaorg/lemur/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron . --disable-gpu --no-sandbox --disable-software-rasterizer --disable-gpu-compositing --disable-gpu-rasterization",
    "install-python": "pip install -r requirements.txt",
    "build:backend": "node build-backend.mjs",
    "build:installer": "electron-builder --config electron-builder.config.js",
    "dist": "npm run build:backend && npm run build:installer",
    "test:js": "node --test \"tests/*.test.js\"",
    "test:py": "python -m unittest discover -s tests -t .",
    "test": "npm run test:js && npm run test:py"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9"
  }
}
